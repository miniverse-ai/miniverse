# Miniverse Configuration

# LLM Provider Configuration
# Options: anthropic, openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano

# API Keys (required for cloud providers)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI/OpenRouter Configuration (choose one option below)

# Option 1: Standard OpenAI API
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_API_BASE=  # Leave empty for standard OpenAI

# Option 2: OpenRouter API (unified access to multiple models)
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3-70b-instruct

# Option 3: Both OpenAI and OpenRouter (switch with OPENAI_API_BASE)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENAI_API_BASE=https://openrouter.ai/api/v1  # Set to OpenRouter endpoint to use OpenRouter
# OPENAI_API_BASE=  # Leave empty to use standard OpenAI

# Popular OpenRouter models:
# - meta-llama/llama-3-70b-instruct (Llama 3 70B)
# - anthropic/claude-3-5-sonnet (Claude 3.5 Sonnet)
# - google/gemini-pro (Gemini Pro)
# - openai/gpt-4-turbo (GPT-4 Turbo)
# - mistralai/mistral-7b-instruct (Mistral 7B)

# Database Configuration
DATABASE_URL=postgresql://localhost/miniverse

# Simulation Configuration
DEFAULT_TICK_COUNT=50
TICK_DURATION_SECONDS=10

# Logging
LOG_LEVEL=INFO
